{
  "name": "garrul",
  "version": "2.19.0",
  "private": true,
  "description": "Self-hosted comment system on Cloudflare Workers + D1 + KV",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/KingPin/Garrul"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "wrangler dev",
    "predev": "npm run build:assets",
    "deploy": "wrangler deploy",
    "predeploy": "npm run build:assets",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "prebuild": "npm run build:assets",
    "build:styles": "tsx scripts/build-styles.ts",
    "prebuild:embed": "npm run build:styles",
    "build:embed": "tsx scripts/build-embed.ts",
    "build:agents": "tsx scripts/build-agents-md.ts",
    "build:assets": "npm run build:embed && npm run build:agents && npm run build:version",
    "size": "npm run build:embed && tsx scripts/check-bundle-size.ts",
    "size:delta": "tsx scripts/bundle-delta.ts",
    "vr": "tsx scripts/visual-regression.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.widget.json",
    "pretypecheck": "npm run build:assets",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "test": "vitest run",
    "pretest": "npm run build:styles",
    "test:watch": "vitest",
    "pretest:watch": "npm run build:styles",
    "migrate": "tsx src/db/migrate.ts",
    "rerender": "tsx scripts/rerender.ts",
    "seed-demo": "tsx scripts/seed-demo.ts",
    "import-disqus": "tsx scripts/import-disqus.ts",
    "db:export": "bash scripts/db-export.sh",
    "upgrade": "tsx scripts/upgrade.ts",
    "manifest:build": "tsx scripts/upgrade/build-manifest.ts",
    "manifest:check": "tsx scripts/upgrade/build-manifest.ts --check",
    "config:build": "tsx scripts/build-config.ts && npm run manifest:build",
    "config:check": "tsx scripts/build-config.ts --check",
    "build:version": "tsx scripts/build-version.ts",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "hono": "^4.13.2",
    "marked": "^18.0.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@cloudflare/workers-types": "^5.20260813.1",
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
