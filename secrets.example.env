# Garrul secrets — template for `wrangler secret bulk`.
#
# Generated by `npm run config:build` from scripts/config-registry.ts. Do not edit by hand.
#
# Usage:
#   cp secrets.example.env secrets.env
#   # uncomment and fill in the ones you need, then:
#   npx wrangler secret bulk secrets.env
#   rm secrets.env
#
# secrets.env is gitignored, but it holds plaintext credentials on disk —
# delete it once the upload succeeds.
#
# LEAVE UNUSED LINES COMMENTED. `wrangler secret bulk` treats an empty
# value as a real, empty secret: an uncommented `RESEND_API_KEY=` would
# overwrite your live key with an empty string rather than skip it.
#
# Not listed here: JWT_SECRET and IP_HASH_SECRET. `scripts/setup.sh`
# pipes `openssl rand -base64 32` straight into wrangler for those, so they
# are never written to disk. Generate them the same way if you set them by
# hand: `openssl rand -base64 32 | npx wrangler secret put JWT_SECRET`.

# --- Turnstile ---
# from dash.cloudflare.com → Turnstile (REQUIRED)
# TURNSTILE_SITE_KEY=
# from dash.cloudflare.com → Turnstile (REQUIRED)
# TURNSTILE_SECRET=

# --- GitHub OAuth ---
# from github.com/settings/developers
# GH_CLIENT_ID=
# from github.com/settings/developers
# GH_CLIENT_SECRET=

# --- Google OAuth ---
# from console.cloud.google.com → OAuth credentials
# GOOGLE_CLIENT_ID=
# from console.cloud.google.com → OAuth credentials
# GOOGLE_CLIENT_SECRET=

# --- Facebook OAuth ---
# from developers.facebook.com → Facebook Login
# FACEBOOK_CLIENT_ID=
# from developers.facebook.com → Facebook Login
# FACEBOOK_CLIENT_SECRET=

# --- X/Twitter OAuth ---
# from developer.x.com → OAuth 2.0 (returns no email)
# TWITTER_CLIENT_ID=
# from developer.x.com → OAuth 2.0
# TWITTER_CLIENT_SECRET=

# --- Discord OAuth ---
# from discord.com/developers → OAuth2
# DISCORD_CLIENT_ID=
# from discord.com/developers → OAuth2
# DISCORD_CLIENT_SECRET=

# --- Email ---
# from resend.com/api-keys
# RESEND_API_KEY=

# --- Webhooks ---
# legacy single-URL webhook; prefer /admin/webhooks endpoints
# WEBHOOK_URL=

# --- Telegram operator bot ---
# BotFather token; see docs/telegram.md
# TELEGRAM_BOT_TOKEN=
# shared secret for setWebhook; required for inbound commands
# TELEGRAM_WEBHOOK_SECRET=

# --- Anti-spam ---
# required when SPAM_PROVIDER = "akismet"
# AKISMET_API_KEY=
# public site URL registered with Akismet
# AKISMET_SITE_URL=
# HMAC key for signed form-timestamp tokens
# SPAM_FORM_TS_SECRET=

# --- Cloudflare usage dashboard ---
# Analytics-read token; scopes in AGENTS-OPERATE §5
# CF_API_TOKEN=

# --- Update checks ---
# no-permission token; raises the 60 req/hr cap
# GITHUB_TOKEN=
