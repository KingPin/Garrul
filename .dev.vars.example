# Copy this file to .dev.vars for local `wrangler dev`.
# .dev.vars is gitignored. NEVER commit real secrets.
#
# Generated by `npm run config:build` from scripts/config-registry.ts. Do not edit by hand.
#
# Blank values are fine locally — a feature is simply off when its
# credentials are unset. Fill in only what you're exercising.

# --- Generated secrets ---
# auto-generated 32-byte secret; reserved for future JWT use
JWT_SECRET="dev-jwt-secret-change-me"
# auto-generated HMAC pepper — generate once and keep it
IP_HASH_SECRET="dev-ip-hash-pepper-change-me"

# --- Turnstile ---
# Cloudflare's "always passes" testing site key — not your real one.
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SITE_KEY="1x00000000000000000000AA"
# the matching "always passes" testing secret
TURNSTILE_SECRET="1x0000000000000000000000000000000AA"

# --- GitHub OAuth ---
# from github.com/settings/developers
GH_CLIENT_ID=""
# from github.com/settings/developers
GH_CLIENT_SECRET=""

# --- Google OAuth ---
# from console.cloud.google.com → OAuth credentials
GOOGLE_CLIENT_ID=""
# from console.cloud.google.com → OAuth credentials
GOOGLE_CLIENT_SECRET=""

# --- Facebook OAuth ---
# from developers.facebook.com → Facebook Login
FACEBOOK_CLIENT_ID=""
# from developers.facebook.com → Facebook Login
FACEBOOK_CLIENT_SECRET=""

# --- X/Twitter OAuth ---
# from developer.x.com → OAuth 2.0 (returns no email)
TWITTER_CLIENT_ID=""
# from developer.x.com → OAuth 2.0
TWITTER_CLIENT_SECRET=""

# --- Discord OAuth ---
# from discord.com/developers → OAuth2
DISCORD_CLIENT_ID=""
# from discord.com/developers → OAuth2
DISCORD_CLIENT_SECRET=""

# --- Email ---
# from resend.com/api-keys
RESEND_API_KEY=""

# --- Webhooks ---
# legacy single-URL webhook; prefer /admin/webhooks endpoints
WEBHOOK_URL=""

# --- Telegram operator bot ---
# BotFather token; see docs/telegram.md
TELEGRAM_BOT_TOKEN=""
# shared secret for setWebhook; required for inbound commands
TELEGRAM_WEBHOOK_SECRET=""

# --- Anti-spam ---
# required when SPAM_PROVIDER = "akismet"
AKISMET_API_KEY=""
# public site URL registered with Akismet
AKISMET_SITE_URL=""
# HMAC key for signed form-timestamp tokens
SPAM_FORM_TS_SECRET=""

# --- Cloudflare usage dashboard ---
# Analytics-read token; scopes in AGENTS-OPERATE §5
CF_API_TOKEN=""

# --- Update checks ---
# read-only public_repo token; raises the 60 req/hr cap
GITHUB_TOKEN=""
